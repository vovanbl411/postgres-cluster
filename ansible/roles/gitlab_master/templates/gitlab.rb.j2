# Минимальный конфиг GitLab
external_url 'http://{{ ansible_default_ipv4.address }}'

# Отключаем лишнее для экономии RAM
gitlab_rails['gitlab_default_projects_features_issues'] = false
gitlab_rails['gitlab_default_projects_features_wiki'] = false
gitlab_rails['gitlab_default_projects_features_snippets'] = false

# PostgreSQL — встроенный, но с ограничениями
postgresql['shared_buffers'] = "256MB"

# Sidekiq workers
sidekiq['max_concurrency'] = 10

# Prometheus — отключаем, если не нужен мониторинг самого GitLab
# (есть VictoriaMetrics)
prometheus_monitoring['enable'] = false

# Registry — отключаем, если не нужен
gitlab_rails['registry_enabled'] = false